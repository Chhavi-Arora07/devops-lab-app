pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps { sh 'docker build -t devops-lab-app:sec .' }
        }
        stage('Security Scan') {
            steps {
                sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ aquasec/trivy:latest image --scanners vuln,secret --severity HIGH,CRITICAL --exit-code 0 devops-lab-app:sec'
            }
        }
        stage('Security Gate') {
            steps {
                sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/ aquasec/trivy:latest image --severity CRITICAL --ignore-unfixed --exit-code 1 devops-lab-app:sec'
            }
        }
    }
    post {
        success { echo 'Security gate passed: no fixable critical vulnerabilities' }
        failure { echo 'Pipeline failed: check the scan output for critical findings' }
    }
}